<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:Subconscious.Desktop.Views"
             xmlns:vm="clr-namespace:Subconscious.Desktop.ViewModels"
             x:Class="Subconscious.Desktop.Views.MainPage"
             x:DataType="vm:MainViewModel"
             Padding="0">

    <!--
      Three panels side by side, exactly as in screens/gui.pen: chat | main | context.
      Columns 1 and 3 are the draggable dividers; MainPage.xaml.cs turns a pan on either one
      into a new width for the panel beside it and persists it (see LayoutStateStore).

      There is no in-app header: the logo, the app name and the context panel toggle all live in
      the window's custom TitleBar (see MainWindow.xaml), so the page is just the panels and the
      rule that separates them from the title bar.
    -->
    <Grid RowDefinitions="1,*">

        <BoxView Grid.Row="0" Color="{DynamicResource DividerColor}" />

        <!-- ── Panels ──────────────────────────────────────────────────────── -->
        <!-- Widths here are just the design defaults; the real values are applied from the
             persisted layout in code-behind before the first frame. -->
        <!-- The parent grid is the sole move/release handler. Pointer capture keeps routed moves
             flowing to it after the pointer has left the 6px splitter hit target. -->
        <Grid x:Name="PanelsGrid" Grid.Row="1" ColumnDefinitions="380,6,*,6,360"
              SizeChanged="OnPanelsGridSizeChanged">
            <Grid.GestureRecognizers>
                <PointerGestureRecognizer PointerMoved="OnPanelsPointerMoved"
                                          PointerReleased="OnPanelsPointerReleased"
                                          PointerExited="OnPanelsPointerExited" />
            </Grid.GestureRecognizers>
            <!-- Hit testing: a layout with no background doesn't take part in it on WinUI, and the
                 drag needs this grid to see pointer moves that happen over the panels. -->
            <Grid.BackgroundColor>
                <DynamicResource Key="SurfaceColor" />
            </Grid.BackgroundColor>

            <views:ChatPanelView Grid.Column="0" BindingContext="{Binding Chat}" />

            <!-- The column remains 6px wide for an easy drag target; only this centered rule is
                 painted, so the divider itself reads as a 1px line. -->
            <Grid x:Name="ChatSplitter" Grid.Column="1" Style="{StaticResource PanelSplitter}"
                  SemanticProperties.Description="Resize chat panel"
                  ToolTipProperties.Text="Drag to resize · double-click to reset">
                <BoxView x:Name="ChatDividerLine" WidthRequest="1" HorizontalOptions="Center"
                         VerticalOptions="Fill" InputTransparent="True"
                         Color="{DynamicResource DividerColor}" />
                <Grid.GestureRecognizers>
                    <PointerGestureRecognizer PointerPressed="OnChatSplitterPressed"
                                              PointerEntered="OnChatSplitterPointerEntered"
                                              PointerExited="OnChatSplitterPointerExited" />
                    <TapGestureRecognizer NumberOfTapsRequired="2" Command="{Binding ResetPanelWidthsCommand}" />
                </Grid.GestureRecognizers>
            </Grid>

            <views:MainPanelView Grid.Column="2" />

            <Grid x:Name="ContextSplitter" Grid.Column="3" Style="{StaticResource PanelSplitter}"
                  SemanticProperties.Description="Resize context panel"
                  ToolTipProperties.Text="Drag to resize · double-click to reset">
                <BoxView x:Name="ContextDividerLine" WidthRequest="1" HorizontalOptions="Center"
                         VerticalOptions="Fill" InputTransparent="True"
                         Color="{DynamicResource DividerColor}" />
                <Grid.GestureRecognizers>
                    <PointerGestureRecognizer PointerPressed="OnContextSplitterPressed"
                                              PointerEntered="OnContextSplitterPointerEntered"
                                              PointerExited="OnContextSplitterPointerExited" />
                    <TapGestureRecognizer NumberOfTapsRequired="2" Command="{Binding ResetPanelWidthsCommand}" />
                </Grid.GestureRecognizers>
            </Grid>

            <views:ContextPanelView Grid.Column="4" IsVisible="{Binding IsContextPanelOpen}" />

        </Grid>

    </Grid>

</ContentPage>
