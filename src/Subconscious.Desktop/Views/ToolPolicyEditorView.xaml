<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons"
             xmlns:vm="clr-namespace:Subconscious.Desktop.ViewModels"
             x:Class="Subconscious.Desktop.Views.ToolPolicyEditorView"
             x:DataType="vm:ToolPolicyEditorViewModel"
             x:Name="Root">
    <VerticalStackLayout Spacing="14">
        <Border BackgroundColor="{DynamicResource PanelBackgroundColor}"
                Stroke="{DynamicResource DividerColor}" StrokeThickness="1"
                StrokeShape="RoundRectangle 7" Padding="0">
            <VerticalStackLayout Spacing="0">
            <Grid Padding="14,12" ColumnDefinitions="*,Auto" ColumnSpacing="10">
            <Grid Grid.Column="0" ColumnDefinitions="Auto,*" ColumnSpacing="10">
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding ToggleBuiltinToolsExpandedCommand}" />
                </Grid.GestureRecognizers>
                <mi:MauiIcon Icon="{mi:Fluent Icon=ChevronRight24}" IconSize="18"
                             IconColor="{DynamicResource SecondaryTextColor}"
                             IsVisible="{Binding IsBuiltinToolsExpanded, Converter={StaticResource InvertedBool}}"
                             VerticalOptions="Center" />
                <mi:MauiIcon Icon="{mi:Fluent Icon=ChevronDown24}" IconSize="18"
                             IconColor="{DynamicResource SecondaryTextColor}"
                             IsVisible="{Binding IsBuiltinToolsExpanded}" VerticalOptions="Center" />
                <VerticalStackLayout Grid.Column="1" Spacing="2">
                    <Label Text="Builtin Tools" Style="{StaticResource FieldLabel}" />
                    <Label Text="Enable tools provided by the engine." Style="{StaticResource MutedLabel}" FontSize="12" />
                </VerticalStackLayout>
            </Grid>
            <Switch Grid.Column="1" IsToggled="{Binding BuiltinToolsEnabled}" />
        </Grid>

        <VerticalStackLayout IsVisible="{Binding IsBuiltinToolsExpanded}"
                             BindableLayout.ItemsSource="{Binding BuiltinGroups}" Spacing="10"
                             Padding="0,0,0,12">
            <BindableLayout.ItemTemplate>
                <DataTemplate x:DataType="vm:ToolPolicyGroupViewModel">
                    <Border BackgroundColor="{DynamicResource PanelBackgroundColor}"
                            Stroke="{DynamicResource DividerColor}" StrokeThickness="1"
                            StrokeShape="RoundRectangle 7" Padding="12"
                            Margin="27,0,9,0">
                        <VerticalStackLayout Spacing="9">
                            <Grid ColumnDefinitions="*,Auto">
                                <Grid Grid.Column="0" ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding ToggleExpandedCommand}" />
                                    </Grid.GestureRecognizers>
                                    <mi:MauiIcon Icon="{mi:Fluent Icon=ChevronRight24}" IconSize="16"
                                                 IconColor="{DynamicResource SecondaryTextColor}"
                                                 IsVisible="{Binding IsExpanded, Converter={StaticResource InvertedBool}}"
                                                 VerticalOptions="Center" />
                                    <mi:MauiIcon Icon="{mi:Fluent Icon=ChevronDown24}" IconSize="16"
                                                 IconColor="{DynamicResource SecondaryTextColor}"
                                                 IsVisible="{Binding IsExpanded}" VerticalOptions="Center" />
                                    <Label Grid.Column="1" Text="{Binding DisplayName}" FontAttributes="Bold" VerticalOptions="Center" />
                                </Grid>
                                <Switch Grid.Column="1" IsToggled="{Binding IsEnabled}"
                                        IsEnabled="{Binding IsParentEnabled}"
                                        TranslationX="7" />
                            </Grid>
                            <VerticalStackLayout IsVisible="{Binding IsExpanded}"
                                                 BindableLayout.ItemsSource="{Binding Tools}" Spacing="6">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="vm:BuiltinToolPolicyViewModel">
                                        <!-- The inset preserves the group relationship while the row stays
                                             individually selectable whenever both parent policies allow it. -->
                                        <Grid Margin="32,2,0,2" ColumnDefinitions="*,Auto" ColumnSpacing="8"
                                              IsEnabled="{Binding IsParentEnabled}">
                                            <VerticalStackLayout Spacing="1">
                                                <Label Text="{Binding Name}" />
                                                <Label Text="{Binding Description}" Style="{StaticResource MutedLabel}" FontSize="11" LineBreakMode="TailTruncation" />
                                            </VerticalStackLayout>
                                            <Switch Grid.Column="1" IsToggled="{Binding IsEnabled}" TranslationX="7" />
                                        </Grid>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </BindableLayout.ItemTemplate>
        </VerticalStackLayout>
            </VerticalStackLayout>
        </Border>

        <Border BackgroundColor="{DynamicResource PanelBackgroundColor}"
                Stroke="{DynamicResource DividerColor}" StrokeThickness="1"
                StrokeShape="RoundRectangle 7" Padding="0">
            <VerticalStackLayout Spacing="0">
            <Grid Padding="14,12" ColumnDefinitions="*,Auto" ColumnSpacing="10" Margin="0,4,0,0">
            <Grid Grid.Column="0" ColumnDefinitions="Auto,*" ColumnSpacing="10">
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding ToggleCustomToolsExpandedCommand}" />
                </Grid.GestureRecognizers>
                <mi:MauiIcon Icon="{mi:Fluent Icon=ChevronRight24}" IconSize="18"
                             IconColor="{DynamicResource SecondaryTextColor}"
                             IsVisible="{Binding IsCustomToolsExpanded, Converter={StaticResource InvertedBool}}"
                             VerticalOptions="Center" />
                <mi:MauiIcon Icon="{mi:Fluent Icon=ChevronDown24}" IconSize="18"
                             IconColor="{DynamicResource SecondaryTextColor}"
                             IsVisible="{Binding IsCustomToolsExpanded}" VerticalOptions="Center" />
                <VerticalStackLayout Grid.Column="1" Spacing="2">
                    <Label Text="Custom Tools" Style="{StaticResource FieldLabel}" />
                    <Label Text="Configured tools are addressed by their stable registry ID." Style="{StaticResource MutedLabel}" FontSize="12" />
                </VerticalStackLayout>
            </Grid>
            <Switch Grid.Column="1" IsToggled="{Binding CustomToolsEnabled}" />
        </Grid>
        <VerticalStackLayout IsVisible="{Binding IsCustomToolsExpanded}" Spacing="6"
                             Padding="0,0,0,12">
            <Label Text="No custom tools are configured." Style="{StaticResource MutedLabel}"
                   IsVisible="{Binding ConfiguredTools.Count, Converter={StaticResource IsEmpty}}" />
            <VerticalStackLayout BindableLayout.ItemsSource="{Binding ConfiguredTools}" Spacing="6">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="vm:ConfiguredToolPolicyViewModel">
                        <Border BackgroundColor="{DynamicResource PanelBackgroundColor}"
                                Stroke="{DynamicResource DividerColor}" StrokeThickness="1"
                                StrokeShape="RoundRectangle 7" Padding="10"
                                Margin="27,0,9,0"
                                IsEnabled="{Binding IsParentEnabled}">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <VerticalStackLayout Spacing="1">
                                    <Label Text="{Binding DisplayName}" />
                                    <Label Text="{Binding Detail}" Style="{StaticResource MutedLabel}" FontSize="11" />
                                </VerticalStackLayout>
                                <Switch Grid.Column="1" IsToggled="{Binding IsEnabled}" TranslationX="5" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
        </VerticalStackLayout>
            </VerticalStackLayout>
        </Border>
    </VerticalStackLayout>
</ContentView>
