<?xml version="1.0" encoding="utf-8" ?>
<!--
  The window itself, so that the custom title bar can be declared in XAML.

  Everything that used to be the in-app header (logo, app name, context panel toggle) now lives
  in Window.TitleBar, which MAUI draws into the OS caption region on Windows and Mac Catalyst.
  That removes the doubled-up chrome the app had before - a native title bar with nothing in it
  sitting on top of an app header with one button in it - and gets back 45px of vertical space.
-->
<Window xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
        xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
        xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons"
        xmlns:vm="clr-namespace:Subconscious.Desktop.ViewModels"
        x:Class="Subconscious.Desktop.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="Subconscious"
        Width="1280"
        Height="800"
        MinimumWidth="960"
        MinimumHeight="600">

    <Window.TitleBar>
        <!--
          32px is the standard Windows title bar height, and it has to be that: the OS draws the
          minimize / maximize / close buttons at a fixed 46x32 and does not stretch them to a taller
          bar, so anything else leaves them floating in a band of dead space.

          Icon + Title are drawn by the TitleBar's own default template, so the leading edge looks
          the same as the header it replaces without any content of our own.
        -->
        <TitleBar Title="Subconscious"
                  Icon="{AppThemeBinding Light=dark_logo.png, Dark=light_logo.png}"
                  HeightRequest="32"
                  BackgroundColor="{DynamicResource SurfaceColor}"
                  ForegroundColor="{DynamicResource PrimaryTextColor}">

            <!-- Dim the title while the window is in the background. The OS does this for its own
                 title bar; a custom one has to opt in. -->
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroupList>
                    <VisualStateGroup x:Name="TitleActiveStates">
                        <VisualState x:Name="TitleBarTitleActive">
                            <VisualState.Setters>
                                <Setter Property="ForegroundColor" Value="{DynamicResource PrimaryTextColor}" />
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState x:Name="TitleBarTitleInactive">
                            <VisualState.Setters>
                                <Setter Property="ForegroundColor" Value="{DynamicResource SecondaryTextColor}" />
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateGroupList>
            </VisualStateManager.VisualStateGroups>

            <!-- The context panel toggle. Trailing content is the slot immediately inside the
                 caption buttons, so this lands to the left of minimize, and no margin keeps it
                 flush with them rather than orphaned a few pixels away.

                 Views placed here handle their own input instead of being treated as window-drag
                 area, so the tap works without registering the toggle in PassthroughElements. -->
            <TitleBar.TrailingContent>
                <Grid x:Name="ContextPanelToggle"
                      Style="{StaticResource TitleBarButton}"
                      SemanticProperties.Description="Toggle context panel"
                      ToolTipProperties.Text="Toggle context panel">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ToggleContextPanelCommand}" />
                    </Grid.GestureRecognizers>
                    <mi:MauiIcon Icon="{mi:Fluent Icon=PanelRight24}" IconSize="16"
                                 IconColor="{Binding IsContextPanelOpen, Converter={StaticResource TitleBarIconColor}}"
                                 HorizontalOptions="Center" VerticalOptions="Center" />
                </Grid>
            </TitleBar.TrailingContent>

        </TitleBar>
    </Window.TitleBar>

</Window>
