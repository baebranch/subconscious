<?xml version="1.0" encoding="utf-8" ?>
<!--
  The title is hosted by MAUI inside Windows' extended native caption region, yielding one
  draggable caption whose surface and text are synchronized by PlatformTheme.
-->
<Window xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
        xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
        xmlns:vm="clr-namespace:Subconscious.Desktop.ViewModels"
        x:Class="Subconscious.Desktop.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="{Binding Chat.TitleBarText}"
        Width="1280"
        Height="800"
        MinimumWidth="960"
        MinimumHeight="600">
    <!-- An explicit MAUI title bar owns the extended caption surface. Binding it to the same
         semantic surface as the panels prevents WinUI's accent-coloured fallback from appearing. -->
    <Window.TitleBar>
        <!-- The title-bar child is hosted outside the Window's normal visual tree, so it must
             explicitly inherit Chat. That keeps its icon, context, indicator, and status as one
             compact left-aligned group instead of measuring the bound labels as empty. -->
        <TitleBar x:Name="AppTitleBar"
                  Title=""
                  Padding="12,0,0,0"
                  HeightRequest="32"
                  BackgroundColor="{DynamicResource PanelBackgroundColor}"
                  ForegroundColor="{DynamicResource PrimaryTextColor}">
            <TitleBar.LeadingContent>
                <HorizontalStackLayout x:Name="TitleBarStatusContent"
                                       Spacing="6"
                                       VerticalOptions="Center">
                    <Image Source="{AppThemeBinding Light=dark_logo.png, Dark=light_logo.png}"
                           WidthRequest="16" HeightRequest="16"
                           VerticalOptions="Center" />
                    <Label x:Name="TitleBarContextLabel"
                           TextColor="{DynamicResource PrimaryTextColor}"
                           FontSize="12" LineBreakMode="NoWrap"
                           VerticalOptions="Center" />
                    <Ellipse x:Name="TitleBarConnectionIndicator"
                             WidthRequest="8" HeightRequest="8"
                             Fill="#72D572"
                             IsVisible="False"
                             VerticalOptions="Center"
                             SemanticProperties.Description="Connected" />
                    <Label x:Name="TitleBarStatusLabel"
                           TextColor="{DynamicResource PrimaryTextColor}"
                           FontSize="12" LineBreakMode="NoWrap"
                           VerticalOptions="Center" />
                </HorizontalStackLayout>
            </TitleBar.LeadingContent>
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroupList>
                    <VisualStateGroup x:Name="TitleActiveStates">
                        <VisualState x:Name="TitleBarTitleActive">
                            <VisualState.Setters>
                                <Setter Property="ForegroundColor" Value="{DynamicResource PrimaryTextColor}" />
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState x:Name="TitleBarTitleInactive">
                            <VisualState.Setters>
                                <Setter Property="ForegroundColor" Value="{DynamicResource SecondaryTextColor}" />
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateGroupList>
            </VisualStateManager.VisualStateGroups>
        </TitleBar>
    </Window.TitleBar>
</Window>
