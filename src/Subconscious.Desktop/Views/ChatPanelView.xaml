<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons"
             xmlns:vm="clr-namespace:Subconscious.Desktop.ViewModels"
             xmlns:views="clr-namespace:Subconscious.Desktop.Views"
             xmlns:controls="clr-namespace:Subconscious.Desktop.Controls"
             x:Class="Subconscious.Desktop.Views.ChatPanelView"
             x:Name="ChatPanelRoot"
             x:DataType="vm:ChatViewModel"
             BackgroundColor="{DynamicResource SurfaceColor}">

    <Grid RowDefinitions="Auto,*,Auto,Auto">

        <!-- ── Header: current thread title + new-thread button ────────────── -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="12,8,12,8"
              HeightRequest="32" MinimumHeightRequest="32">
            <!-- A local draft deliberately has no title until its first message reaches the
                 engine, which creates and names the persisted thread. -->
            <Label Grid.Column="0"
                   Text="{Binding CurrentThread.Title}"
                   FontSize="14" FontAttributes="Bold"
                   VerticalOptions="Fill" VerticalTextAlignment="Center" />
            <ImageButton Grid.Column="1" Style="{StaticResource SquareIconButton}"
                         mi:MauiIcon.Value="{mi:Fluent Icon=Add24, IconSize=16, IconColor={Binding IconColor}}"
                         Command="{Binding NewThreadCommand}"
                         VerticalOptions="Center"
                         SemanticProperties.Description="New thread"
                         ToolTipProperties.Text="New thread" />
        </Grid>

        <!-- Native bubbles let DynamicResource repaint the transcript and the platform render
             themed scrollbars without regenerating a second HTML document. -->
        <CollectionView x:Name="MessagesView"
                        Grid.Row="1"
                        ItemsSource="{Binding Messages}"
                        SelectionMode="None"
                        Margin="12,0">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="0" />
            </CollectionView.ItemsLayout>
            <CollectionView.EmptyView>
                <Label Text="Start a conversation." Style="{StaticResource MutedLabel}"
                       HorizontalOptions="Center" VerticalOptions="Center" />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:MessageViewModel">
                    <!-- CollectionView stretches its root item. This transparent wrapper owns that
                         full row; the contained Border measures to its content then aligns to the
                         sender/responder edge, capped at 525px. -->
                    <Grid>
                        <Border MaximumWidthRequest="525"
                                Margin="0,0,0,8"
                                Padding="10,8"
                                StrokeThickness="0"
                                BackgroundColor="{DynamicResource AssistantBubbleColor}"
                                HorizontalOptions="{Binding IsUser, Converter={StaticResource BubbleAlignment}}">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="5" />
                            </Border.StrokeShape>
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding IsUser}" Value="True">
                                    <Setter Property="BackgroundColor" Value="{DynamicResource UserBubbleColor}" />
                                </DataTrigger>
                            </Border.Triggers>
                            <VerticalStackLayout Spacing="0" HorizontalOptions="Start">
                                <!-- All non-tool content is parsed by Markdig and rendered with native,
                                     semantic-resource-aware controls rather than raw Markdown text. -->
                                <views:MarkdownMessageView Markdown="{Binding Content}"
                                                           HorizontalOptions="Start"
                                                           IsVisible="{Binding IsTool, Converter={StaticResource InvertedBool}}" />

                                <!-- Collapsed tools stay on one compact metadata row. The chevron
                                     alone toggles detail, keeping the adjacent copy action independent. -->
                                <VerticalStackLayout IsVisible="{Binding IsTool}" Spacing="0" HorizontalOptions="Start">
                                    <Grid Padding="0" ColumnDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="6">
                                        <Label Text="{Binding ToolTitle}"
                                               LineBreakMode="NoWrap" VerticalOptions="Center" />
                                        <Label Grid.Column="1" Text="{Binding Timestamp}"
                                               Style="{StaticResource MutedLabel}" FontSize="11"
                                               VerticalOptions="Center" />
                                        <Border Grid.Column="2" Style="{StaticResource BubbleCopyButton}"
                                                SemanticProperties.Description="Copy tool message"
                                                ToolTipProperties.Text="Copy tool message">
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Tapped="OnCopyMessageTapped" />
                                            </Border.GestureRecognizers>
                                            <Image InputTransparent="True"
                                                   mi:MauiIcon.Value="{mi:Fluent Icon=Copy24, IconSize=15, IconColor={Binding Source={x:Reference ChatPanelRoot}, Path=BindingContext.IconColor}}" />
                                        </Border>
                                        <!-- Segoe Fluent Icons supplies the familiar Windows expand/collapse chevrons. -->
                                        <Label Grid.Column="3" Text="{Binding ToolExpansionGlyph}"
                                               FontFamily="Segoe Fluent Icons" FontSize="12"
                                               VerticalOptions="Center"
                                               SemanticProperties.Description="Show or hide tool details"
                                               ToolTipProperties.Text="Show or hide tool details">
                                            <Label.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding ToggleToolExpandedCommand}" />
                                            </Label.GestureRecognizers>
                                        </Label>
                                    </Grid>
                                    <ScrollView IsVisible="{Binding IsToolExpanded}"
                                                Margin="0,8,0,0"
                                                MaximumHeightRequest="260"
                                                Orientation="Vertical">
                                        <VerticalStackLayout Spacing="0">
                                            <VerticalStackLayout Spacing="2">
                                                <Label Text="Input" Style="{StaticResource MutedLabel}" />
                                                <Label Text="{Binding ToolInput}" FontFamily="monospace"
                                                       LineBreakMode="WordWrap" />
                                            </VerticalStackLayout>
                                            <BoxView HeightRequest="1" Color="{DynamicResource DividerColor}"
                                                     IsVisible="{Binding ToolOutput, Converter={StaticResource IsNotEmpty}}" />
                                            <VerticalStackLayout Spacing="2"
                                                                 IsVisible="{Binding ToolOutput, Converter={StaticResource IsNotEmpty}}">
                                                <Label Text="Output" Style="{StaticResource MutedLabel}" />
                                                <Label Text="{Binding ToolOutput}" FontFamily="monospace"
                                                       LineBreakMode="WordWrap" />
                                            </VerticalStackLayout>
                                        </VerticalStackLayout>
                                    </ScrollView>
                                </VerticalStackLayout>

                                <!-- A horizontal, content-sized footer avoids the former star column
                                     that forced even a short message to consume the whole row. Tools
                                     deliberately have no footer so their collapsed form remains one line. -->
                                <HorizontalStackLayout IsVisible="{Binding IsTool, Converter={StaticResource InvertedBool}}"
                                                       Margin="0,6,0,0"
                                                       Spacing="6"
                                                       HorizontalOptions="End">
                                    <Label Text="{Binding Timestamp}" Style="{StaticResource MutedLabel}"
                                           FontSize="11" VerticalOptions="Center" />
                                    <Border Style="{StaticResource BubbleCopyButton}"
                                            SemanticProperties.Description="Copy message"
                                            ToolTipProperties.Text="Copy message">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnCopyMessageTapped" />
                                        </Border.GestureRecognizers>
                                        <Image InputTransparent="True"
                                               mi:MauiIcon.Value="{mi:Fluent Icon=Copy24, IconSize=15, IconColor={Binding Source={x:Reference ChatPanelRoot}, Path=BindingContext.IconColor}}" />
                                    </Border>
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                        </Border>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- ── Chat omnibox ────────────────────────────────────────────────── -->
        <!-- Keep every interaction backed by ChatViewModel: the engine currently supports text
             prompts and cancellation, so attachment/model/voice affordances are not presented as
             if they were available. -->
        <Border Grid.Row="2" Margin="16,0,16,12" Padding="8,6,6,6"
                BackgroundColor="{DynamicResource SurfaceColor}"
                Stroke="{DynamicResource DividerBrush}" StrokeThickness="0.5">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="8" />
            </Border.StrokeShape>
            <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto" RowSpacing="4">
                <!-- This remains a native multiline editor: it begins compact, expands through
                     five lines, then uses the platform scrollbar for longer prompts. -->
                <controls:ChatComposerEditor Grid.Row="0" Grid.ColumnSpan="2"
                                             Text="{Binding ComposerText, Mode=TwoWay}"
                                             SubmitCommand="{Binding SendCommand}"
                                             Placeholder="Ask anything..."
                                             AutoSize="TextChanges"
                                             Style="{StaticResource ChatComposerEditor}"
                                             SemanticProperties.Description="Chat message. Enter sends; Shift plus Enter inserts a new line." />

                <!-- Draft selection is explicitly two-way: it is retained locally before a
                     thread exists and sent with the opening prompt that materializes the thread. -->
                <Picker Grid.Row="1"
                        WidthRequest="120"
                        HeightRequest="30"
                        HorizontalOptions="Start"
                        FontSize="11"
                        ItemsSource="{Binding AvailableModels}"
                        ItemDisplayBinding="{Binding Name}"
                        SelectedItem="{Binding SelectedModel, Mode=TwoWay}"
                        IsEnabled="{Binding IsModelPickerEnabled}"
                        SemanticProperties.Description="Model for this thread"
                        ToolTipProperties.Text="Select model for this thread" />

                <ImageButton Grid.Row="1" Grid.Column="1" Style="{StaticResource SquareIconButton}"
                             mi:MauiIcon.Value="{mi:Fluent Icon=Send24, IconSize=16, IconColor={Binding IconColor}}"
                             Command="{Binding SendCommand}"
                             IsVisible="{Binding IsBusy, Converter={StaticResource InvertedBool}}"
                             SemanticProperties.Description="Send message"
                             ToolTipProperties.Text="Send" />
                <Button Grid.Row="1" Grid.Column="1" Text="■" Style="{StaticResource RoundAccentButton}"
                        Command="{Binding StopCommand}"
                        IsVisible="{Binding IsBusy}"
                        SemanticProperties.Description="Stop generating"
                        ToolTipProperties.Text="Stop" />
            </Grid>
        </Border>

    </Grid>

</ContentView>
