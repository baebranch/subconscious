<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons"
             xmlns:vm="clr-namespace:Subconscious.Desktop.ViewModels"
             xmlns:views="clr-namespace:Subconscious.Desktop.Views"
             x:Class="Subconscious.Desktop.Views.MainPanelView"
             x:Name="MainPanelRoot"
             x:DataType="vm:MainViewModel"
             BackgroundColor="{DynamicResource SurfaceColor}">

    <!-- Center panel. Shows the workspace create/edit form or the General Settings form when one
         is open (MainViewModel only ever opens one at a time — see OpenWorkspaceForm /
         OpenGeneralSettings), otherwise the Files/Preview/Terminal placeholder. -->
    <Grid>

        <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="8"
                             IsVisible="{Binding IsCenterPanelIdle}">
            <Label Text="Utility panel" FontSize="16" Style="{StaticResource MutedLabel}"
                   HorizontalOptions="Center" />
            <Label Text="Files · Preview · Terminal — coming soon" Style="{StaticResource MutedLabel}"
                   HorizontalOptions="Center" />
        </VerticalStackLayout>

        <!-- Both forms live in the same responsive shell: the centered content stops growing at
             750px, while the grid's padding leaves a comfortable gutter and lets it shrink with
             a narrow center panel rather than causing horizontal clipping. -->
        <ScrollView IsVisible="{Binding IsWorkspaceFormOpen}" Orientation="Vertical">
            <Grid x:Name="WorkspaceFormHost" Padding="24,28" HorizontalOptions="Center">
                <VerticalStackLayout x:Name="WorkspaceEditor"
                                     BindingContext="{Binding WorkspaceForm}"
                                     x:DataType="vm:WorkspaceFormViewModel"
                                     MaximumWidthRequest="750" Spacing="18"
                                     HorizontalOptions="Fill">

                    <Label Text="{Binding IsEditMode, Converter={StaticResource WorkspaceFormTitle}}"
                           FontSize="18" FontAttributes="Bold" />

                    <VerticalStackLayout Spacing="6">
                        <Label Text="Name" Style="{StaticResource FieldLabel}" />
                        <Entry Text="{Binding Name}" Placeholder="Workspace name" Style="{StaticResource FormEntry}" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="6">
                        <Label Text="Description" Style="{StaticResource FieldLabel}" />
                        <Editor Text="{Binding Description}" Placeholder="Optional description"
                                Style="{StaticResource FormEditor}" AutoSize="TextChanges" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="6">
                        <Label Text="Default model" Style="{StaticResource FieldLabel}" />
                        <Picker ItemsSource="{Binding AvailableModels}"
                                ItemDisplayBinding="{Binding Name}"
                                SelectedItem="{Binding SelectedDefaultModel, Mode=TwoWay}"
                                Title="Select a model" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="8">
                        <Label Text="Workspace path allow list" Style="{StaticResource FieldLabel}" />
                        <Label Text="Only listed absolute folders may be granted to filesystem, image, download, and terminal tools for this workspace."
                               Style="{StaticResource MutedLabel}" FontSize="12" LineBreakMode="WordWrap" />
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <Entry Text="{Binding NewWorkspacePath}" Placeholder="C:\\Projects\\example"
                                   Style="{StaticResource FormEntry}"
                                   SemanticProperties.Description="Absolute workspace folder path" />
                            <Button Grid.Column="1" Text="Add" Command="{Binding AddWorkspacePathCommand}"
                                    Style="{StaticResource GhostButton}"
                                    SemanticProperties.Description="Add workspace folder path" />
                        </Grid>
                        <Label Text="No workspace paths have been allowed yet. Local file-oriented tools will have no workspace scope."
                               Style="{StaticResource MutedLabel}" FontSize="12"
                               IsVisible="{Binding WorkspacePaths.Count, Converter={StaticResource IsEmpty}}" />
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding WorkspacePaths}" Spacing="6">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="{x:Null}">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <Label Text="{Binding .}" LineBreakMode="MiddleTruncation" VerticalOptions="Center" />
                                        <Button Grid.Column="1" Text="Remove"
                                                Command="{Binding BindingContext.RemoveWorkspacePathCommand, Source={x:Reference WorkspaceEditor}}"
                                                CommandParameter="{Binding .}"
                                                Style="{StaticResource GhostButton}"
                                                SemanticProperties.Description="Remove workspace folder path" />
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="Build knowledge graph" Style="{StaticResource FieldLabel}" />
                            <Label Text="Enable semantic_graph for this workspace." Style="{StaticResource MutedLabel}" FontSize="12" />
                        </VerticalStackLayout>
                        <Switch Grid.Column="1" IsToggled="{Binding BuildKnowledgeGraph}" />
                    </Grid>

                    <Label Text="Require approval" Style="{StaticResource FieldLabel}" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <Label Text="Queries" VerticalOptions="Center" />
                        <Switch Grid.Column="1" IsToggled="{Binding RequireApprovalForQueries}" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <Label Text="Mutations" VerticalOptions="Center" />
                        <Switch Grid.Column="1" IsToggled="{Binding RequireApprovalForMutations}" />
                    </Grid>

                    <Label Text="Tool allow list" Style="{StaticResource FieldLabel}" />
                    <Label Text="Choose the built-in tool groups and individual functions this workspace may offer to agents. Thread policies may further restrict or override this default."
                           Style="{StaticResource MutedLabel}" FontSize="12" LineBreakMode="WordWrap" />
                    <ActivityIndicator IsRunning="{Binding IsInitializing}" IsVisible="{Binding IsInitializing}" />
                    <views:ToolPolicyEditorView BindingContext="{Binding ToolPolicy}" />

                    <VerticalStackLayout Spacing="6" IsVisible="{Binding IsEditMode}">
                        <Label Text="UUID" Style="{StaticResource FieldLabel}" />
                        <Label Text="{Binding Uuid}" FontSize="12" />
                    </VerticalStackLayout>

                    <Grid ColumnDefinitions="*,*" IsVisible="{Binding IsEditMode}">
                        <VerticalStackLayout Grid.Column="0" Spacing="6">
                            <Label Text="Created" Style="{StaticResource FieldLabel}" />
                            <Label Text="{Binding CreatedAt}" FontSize="12" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="6">
                            <Label Text="Updated" Style="{StaticResource FieldLabel}" />
                            <Label Text="{Binding UpdatedAt}" FontSize="12" />
                        </VerticalStackLayout>
                    </Grid>

                    <Label Text="{Binding ErrorText}" TextColor="{DynamicResource ErrorColor}" FontSize="12"
                           LineBreakMode="WordWrap"
                           IsVisible="{Binding ErrorText, Converter={StaticResource IsNotEmpty}}" />

                    <HorizontalStackLayout Spacing="10">
                        <Button Text="{Binding IsEditMode, Converter={StaticResource WorkspaceFormSaveLabel}}"
                                Command="{Binding SaveCommand}"
                                Style="{StaticResource AccentButton}" />
                        <Button Text="Cancel" Command="{Binding CancelCommand}"
                                Style="{StaticResource GhostButton}" />
                    </HorizontalStackLayout>

                </VerticalStackLayout>
            </Grid>
        </ScrollView>

        <!-- General Settings: Picker/Entry are left unstyled so each platform's native control
             chrome shows through. -->
        <ScrollView IsVisible="{Binding IsGeneralSettingsPageOpen}" Orientation="Vertical">
            <Grid x:Name="SettingsFormHost" Padding="24,28" HorizontalOptions="Center">
                <VerticalStackLayout BindingContext="{Binding SettingsForm}"
                                     x:DataType="vm:SettingsFormViewModel"
                                     MaximumWidthRequest="750" Spacing="18"
                                     HorizontalOptions="Fill">

                    <Label Text="General Settings" FontSize="18" FontAttributes="Bold" />

                    <VerticalStackLayout Spacing="6">
                        <Label Text="Mode" Style="{StaticResource FieldLabel}" />
                        <Picker ItemsSource="{Binding ModeOptions}" SelectedItem="{Binding Mode}" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="6">
                        <Label Text="Colour Theme" Style="{StaticResource FieldLabel}" />
                        <Picker ItemsSource="{Binding ColourThemeOptions}" SelectedItem="{Binding ColourTheme}" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="6">
                        <Label Text="Sidebar position" Style="{StaticResource FieldLabel}" />
                        <Picker ItemsSource="{Binding BindingContext.SidebarPositionOptions, Source={x:Reference MainPanelRoot}}"
                                ItemDisplayBinding="{Binding DisplayName}"
                                SelectedItem="{Binding BindingContext.SelectedSidebarPosition, Source={x:Reference MainPanelRoot}, Mode=TwoWay}"
                                SemanticProperties.Description="Choose whether the sidebar appears on the left or right"
                                ToolTipProperties.Text="Choose sidebar position" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="6">
                        <Label Text="Panel configuration" Style="{StaticResource FieldLabel}" />
                        <Picker ItemsSource="{Binding BindingContext.PanelConfigurationOptions, Source={x:Reference MainPanelRoot}}"
                                ItemDisplayBinding="{Binding DisplayName}"
                                SelectedItem="{Binding BindingContext.SelectedPanelConfiguration, Source={x:Reference MainPanelRoot}, Mode=TwoWay}"
                                SemanticProperties.Description="Choose the order of the chat, context, and main panels"
                                ToolTipProperties.Text="Choose panel order" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="6">
                        <Label Text="Data Folder" Style="{StaticResource FieldLabel}" />
                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                            <Entry Grid.Column="0" Text="{Binding DataDirectory}" IsReadOnly="True" IsEnabled="False" />
                            <ImageButton Grid.Column="1" Style="{StaticResource SquareIconButton}"
                                         mi:MauiIcon.Value="{mi:Fluent Icon=DocumentCopy24, IconSize=16, IconColor={Binding IconColor}}"
                                         Command="{Binding CopyDataDirectoryCommand}"
                                         SemanticProperties.Description="Copy data folder path"
                                         ToolTipProperties.Text="Copy path" />
                            <ImageButton Grid.Column="2" Style="{StaticResource SquareIconButton}"
                                         mi:MauiIcon.Value="{mi:Fluent Icon=OpenFolder24, IconSize=16, IconColor={Binding IconColor}}"
                                         Command="{Binding OpenDataDirectoryCommand}"
                                         SemanticProperties.Description="Open data folder"
                                         ToolTipProperties.Text="Open in file explorer" />
                        </Grid>
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </Grid>
        </ScrollView>

        <!-- Model configurations are loaded from the engine's encrypted data.enc store. The API
             returns only redacted metadata; API-key input is write-only. -->
        <ScrollView IsVisible="{Binding IsModelsSettingsPageOpen}" Orientation="Vertical">
            <Grid x:Name="ModelsSettingsHost" Padding="24,28" HorizontalOptions="Center">
                <VerticalStackLayout BindingContext="{Binding ModelSettingsForm}"
                                     x:DataType="vm:ModelSettingsFormViewModel"
                                     MaximumWidthRequest="750" Spacing="18" HorizontalOptions="Fill">
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
                        <Label Text="Models" Style="{StaticResource SettingsSectionTitle}" />
                        <Button Grid.Column="1" Text="Reload" Command="{Binding LoadCommand}"
                                Style="{StaticResource GhostButton}"
                                SemanticProperties.Description="Reload encrypted model configurations"
                                ToolTipProperties.Text="Reload configurations" />
                        <Button Grid.Column="2" Text="New configuration" Command="{Binding AddConfigurationCommand}"
                                Style="{StaticResource AccentButton}"
                                SemanticProperties.Description="Add a new model configuration"
                                ToolTipProperties.Text="New model configuration" />
                    </Grid>
                    <Label Text="Configurations are stored encrypted by the local engine. Saved API keys are never returned to this app."
                           Style="{StaticResource MutedLabel}" LineBreakMode="WordWrap" />
                    <Label Text="{Binding ErrorText}" TextColor="{DynamicResource ErrorColor}" FontSize="12"
                           LineBreakMode="WordWrap" IsVisible="{Binding ErrorText, Converter={StaticResource IsNotEmpty}}" />

                    <Label Text="No model configurations yet. Add one to get started."
                           Style="{StaticResource MutedLabel}" HorizontalOptions="Center"
                           Margin="0,28" IsVisible="{Binding Configurations.Count, Converter={StaticResource IsEmpty}}" />

                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Configurations}" Spacing="10">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:ModelConfigurationViewModel">
                                <Border BackgroundColor="{DynamicResource PanelBackgroundColor}"
                                        Stroke="{DynamicResource DividerColor}" StrokeThickness="1"
                                        StrokeShape="RoundRectangle 7" Padding="0">
                                    <VerticalStackLayout Spacing="0">
                                        <Grid Padding="14,12" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10"
                                              SemanticProperties.Description="{Binding DisplayName}"
                                              ToolTipProperties.Text="Open model configuration">
                                            <Grid.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding ToggleExpandedCommand}" />
                                            </Grid.GestureRecognizers>
                                            <mi:MauiIcon Icon="{mi:Fluent Icon=ChevronRight24}" IconSize="18"
                                                         IconColor="{DynamicResource SecondaryTextColor}"
                                                         IsVisible="{Binding IsExpanded, Converter={StaticResource InvertedBool}}"
                                                         VerticalOptions="Center" />
                                            <mi:MauiIcon Icon="{mi:Fluent Icon=ChevronDown24}" IconSize="18"
                                                         IconColor="{DynamicResource SecondaryTextColor}"
                                                         IsVisible="{Binding IsExpanded}"
                                                         VerticalOptions="Center" />
                                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                                <Label Text="{Binding DisplayName}" FontAttributes="Bold" LineBreakMode="TailTruncation" />
                                                <Label Text="{Binding Summary}" Style="{StaticResource MutedLabel}"
                                                       LineBreakMode="TailTruncation" />
                                            </VerticalStackLayout>
                                            <Label Grid.Column="2" Text="Edit" Style="{StaticResource MutedLabel}"
                                                   VerticalOptions="Center" />
                                        </Grid>

                                        <BoxView HeightRequest="1" Color="{DynamicResource DividerColor}"
                                                 IsVisible="{Binding IsExpanded}" />
                                        <VerticalStackLayout Padding="14,16" Spacing="14" IsVisible="{Binding IsExpanded}">
                                            <VerticalStackLayout Spacing="6">
                                                <Label Text="Alias" Style="{StaticResource FieldLabel}" />
                                                <Entry Text="{Binding Alias}" Placeholder="A memorable name for this configuration"
                                                       Style="{StaticResource FormEntry}" />
                                            </VerticalStackLayout>
                                            <VerticalStackLayout Spacing="6">
                                                <Label Text="Provider" Style="{StaticResource FieldLabel}" />
                                                <Picker ItemsSource="{Binding ProviderOptions}" SelectedItem="{Binding Provider}"
                                                        Title="Select a provider" />
                                            </VerticalStackLayout>
                                            <VerticalStackLayout Spacing="6">
                                                <Label Text="Model" Style="{StaticResource FieldLabel}" />
                                                <Entry Text="{Binding Model}" Placeholder="Enter the model key" Style="{StaticResource FormEntry}" />
                                            </VerticalStackLayout>
                                            <VerticalStackLayout Spacing="6">
                                                <Label Text="API Key" Style="{StaticResource FieldLabel}" />
                                                <Entry Text="{Binding ApiKey}" IsPassword="True" Placeholder="Enter a replacement API key"
                                                       Style="{StaticResource FormEntry}" />
                                                <Label Text="An API key is already saved. Leave this blank to keep it."
                                                       Style="{StaticResource MutedLabel}" FontSize="12"
                                                       IsVisible="{Binding HasApiKey}" />
                                            </VerticalStackLayout>
                                            <VerticalStackLayout Spacing="6" IsVisible="{Binding IsBaseUrlVisible}">
                                                <Label Text="Base URL (OpenAI-compatible API)" Style="{StaticResource FieldLabel}" />
                                                <Entry Text="{Binding BaseUrl}" Placeholder="{Binding BaseUrlPlaceholder}"
                                                       Style="{StaticResource FormEntry}" />
                                            </VerticalStackLayout>
                                            <VerticalStackLayout Spacing="6">
                                                <Label Text="Context Window (tokens)" Style="{StaticResource FieldLabel}" />
                                                <Entry Text="{Binding ContextWindow}" Keyboard="Numeric" Placeholder="Default: 8192"
                                                       Style="{StaticResource FormEntry}" />
                                            </VerticalStackLayout>
                                            <Label Text="{Binding ErrorText}" TextColor="{DynamicResource ErrorColor}" FontSize="12"
                                                   LineBreakMode="WordWrap" IsVisible="{Binding ErrorText, Converter={StaticResource IsNotEmpty}}" />
                                            <HorizontalStackLayout Spacing="10">
                                                <Button Text="Save" Command="{Binding SaveCommand}" Style="{StaticResource AccentButton}"
                                                        SemanticProperties.Description="Save model configuration" />
                                                <Button Text="Delete" Command="{Binding DeleteCommand}" Style="{StaticResource GhostButton}"
                                                        SemanticProperties.Description="Delete model configuration" />
                                            </HorizontalStackLayout>
                                        </VerticalStackLayout>
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Grid>
        </ScrollView>

        <!-- Configured tools are persisted by the engine registry. Names are server-managed and
             therefore deliberately absent from the user-facing editor. -->
        <ScrollView IsVisible="{Binding IsToolsSettingsPageOpen}" Orientation="Vertical">
            <Grid x:Name="ToolsSettingsHost" Padding="24,28" HorizontalOptions="Center">
                <VerticalStackLayout BindingContext="{Binding ToolSettingsForm}"
                                     x:DataType="vm:ToolSettingsFormViewModel"
                                     MaximumWidthRequest="750" Spacing="18" HorizontalOptions="Fill">
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
                        <Label Text="Tools" Style="{StaticResource SettingsSectionTitle}" />
                        <Button Grid.Column="1" Text="Reload" Command="{Binding LoadCommand}" Style="{StaticResource GhostButton}" />
                        <Button Grid.Column="2" Text="New tool" Command="{Binding AddToolCommand}" Style="{StaticResource AccentButton}" />
                    </Grid>
                    <Label Text="Configure scripts, MCP servers, and API tools. Secrets are not managed by this app."
                           Style="{StaticResource MutedLabel}" LineBreakMode="WordWrap" />
                    <Label Text="{Binding ErrorText}" TextColor="{DynamicResource ErrorColor}" FontSize="12"
                           IsVisible="{Binding ErrorText, Converter={StaticResource IsNotEmpty}}" />
                    <Label Text="No configured tools yet. Add one to make it available in policies."
                           Style="{StaticResource MutedLabel}" HorizontalOptions="Center" Margin="0,28"
                           IsVisible="{Binding Tools.Count, Converter={StaticResource IsEmpty}}" />
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Tools}" Spacing="10">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:ToolRegistryViewModel">
                                <Border BackgroundColor="{DynamicResource PanelBackgroundColor}" Stroke="{DynamicResource DividerColor}"
                                        StrokeThickness="1" StrokeShape="RoundRectangle 7" Padding="0">
                                    <VerticalStackLayout Spacing="0">
                                        <Grid Padding="14,12" ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                            <Grid.GestureRecognizers><TapGestureRecognizer Command="{Binding ToggleExpandedCommand}" /></Grid.GestureRecognizers>
                                            <VerticalStackLayout Spacing="2">
                                                <Label Text="{Binding DisplayName}" FontAttributes="Bold" />
                                                <Label Text="{Binding Summary}" Style="{StaticResource MutedLabel}" LineBreakMode="TailTruncation" />
                                            </VerticalStackLayout>
                                            <Label Grid.Column="1" Text="Edit" Style="{StaticResource MutedLabel}" VerticalOptions="Center" />
                                        </Grid>
                                        <VerticalStackLayout Padding="14,16" Spacing="14" IsVisible="{Binding IsExpanded}">
                                            <VerticalStackLayout Spacing="6"><Label Text="Alias" Style="{StaticResource FieldLabel}" /><Entry Text="{Binding Alias}" Placeholder="Memorable name for this tool" Style="{StaticResource FormEntry}" /></VerticalStackLayout>
                                            <VerticalStackLayout Spacing="6"><Label Text="Tool Type" Style="{StaticResource FieldLabel}" /><Picker ItemsSource="{Binding ToolTypeOptions}" SelectedItem="{Binding ToolType}" /></VerticalStackLayout>
                                            <VerticalStackLayout Spacing="8" IsVisible="{Binding IsScriptTool}">
                                                <VerticalStackLayout Spacing="6"><Label Text="Language" Style="{StaticResource FieldLabel}" /><Picker ItemsSource="{Binding ScriptLanguageOptions}" SelectedItem="{Binding ScriptLanguage}" /></VerticalStackLayout>
                                                <VerticalStackLayout Spacing="6"><Label Text="Script Path" Style="{StaticResource FieldLabel}" /><Entry Text="{Binding ScriptPath}" Placeholder="Path to the script" Style="{StaticResource FormEntry}" /></VerticalStackLayout>
                                            </VerticalStackLayout>
                                            <VerticalStackLayout Spacing="6" IsVisible="{Binding IsEndpointTool}"><Label Text="Endpoint URL" Style="{StaticResource FieldLabel}" /><Entry Text="{Binding EndpointUrl}" Placeholder="https://…" Style="{StaticResource FormEntry}" /></VerticalStackLayout>
                                            <VerticalStackLayout Spacing="6"><Label Text="Authentication" Style="{StaticResource FieldLabel}" /><Picker ItemsSource="{Binding AuthTypeOptions}" SelectedItem="{Binding AuthType}" Title="None" /></VerticalStackLayout>
                                            <Label Text="{Binding ErrorText}" TextColor="{DynamicResource ErrorColor}" FontSize="12" IsVisible="{Binding ErrorText, Converter={StaticResource IsNotEmpty}}" />
                                            <HorizontalStackLayout Spacing="10"><Button Text="Save" Command="{Binding SaveCommand}" Style="{StaticResource AccentButton}" /><Button Text="Delete" Command="{Binding DeleteCommand}" Style="{StaticResource GhostButton}" /></HorizontalStackLayout>
                                        </VerticalStackLayout>
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Grid>
        </ScrollView>

        <!-- Skills combine editable registry fields with validation-derived status and tool data. -->
        <ScrollView IsVisible="{Binding IsSkillsSettingsPageOpen}" Orientation="Vertical">
            <Grid x:Name="SkillsSettingsHost" Padding="24,28" HorizontalOptions="Center">
                <VerticalStackLayout BindingContext="{Binding SkillSettingsForm}"
                                     x:DataType="vm:SkillSettingsFormViewModel"
                                     MaximumWidthRequest="750" Spacing="18" HorizontalOptions="Fill">
                    <Label Text="Skills" Style="{StaticResource SettingsSectionTitle}" />
                    <Label Text="Skill configuration and validation endpoints are not available in the engine yet; entered values remain only for this desktop session."
                           TextColor="{DynamicResource SecondaryTextColor}" LineBreakMode="WordWrap" />

                    <VerticalStackLayout Spacing="6">
                        <Label Text="Name" Style="{StaticResource FieldLabel}" />
                        <Entry Text="{Binding Name}" Placeholder="Required registry name" Style="{StaticResource FormEntry}" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Alias" Style="{StaticResource FieldLabel}" />
                        <Entry Text="{Binding Alias}" Placeholder="Memorable name for this skill" Style="{StaticResource FormEntry}" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Description" Style="{StaticResource FieldLabel}" />
                        <Editor Text="{Binding Description}" Placeholder="Optional description" AutoSize="TextChanges"
                                Style="{StaticResource FormEditor}" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Source Type" Style="{StaticResource FieldLabel}" />
                        <Picker ItemsSource="{Binding SourceTypeOptions}" SelectedItem="{Binding SourceType}" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Source" Style="{StaticResource FieldLabel}" />
                        <Entry Text="{Binding Source}" Placeholder="Folder path, zip path, or URL / Git source"
                               Style="{StaticResource FormEntry}" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Validation Status" Style="{StaticResource FieldLabel}" />
                        <Label Text="{Binding Status}" Style="{StaticResource SettingsFieldValueLabel}" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Spacing="6" IsVisible="{Binding IsValidated}">
                        <Label Text="Required Tools" Style="{StaticResource FieldLabel}" />
                        <Label Text="{Binding RequiredTools}" Style="{StaticResource SettingsFieldValueLabel}" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Grid>
        </ScrollView>

        <!-- About keeps its heading at the top, while the app identity and useful links remain
             centered in the available panel space. It deliberately does not use card chrome. -->
        <Grid IsVisible="{Binding IsAboutSettingsPageOpen}" RowDefinitions="Auto,1*,Auto,1*">
            <HorizontalStackLayout Grid.Row="0" Margin="0,28,0,0" Spacing="6"
                                   HorizontalOptions="Center" VerticalOptions="Start">
                <mi:MauiIcon Icon="{mi:Fluent Icon=Info24}" IconSize="18"
                             IconColor="{Binding IconColor}" VerticalOptions="Center" />
                <Label Text="About" FontSize="18" FontAttributes="Bold" VerticalOptions="Center" />
            </HorizontalStackLayout>

            <Grid x:Name="AboutSettingsHost" Grid.Row="2" Padding="24,24,24,48"
                  HorizontalOptions="Center" BindingContext="{Binding AboutSettings}"
                  x:DataType="vm:AboutSettingsViewModel">
                <VerticalStackLayout MaximumWidthRequest="750" Spacing="0"
                                     HorizontalOptions="Fill">
                    <Image Source="{AppThemeBinding Light=dark_logo.png, Dark=light_logo.png}"
                           WidthRequest="88" HeightRequest="88" Aspect="AspectFit"
                           HorizontalOptions="Center" Margin="0,0,0,12" />
                    <Label Text="Subconscious" FontSize="20" FontAttributes="Bold"
                           HorizontalOptions="Center" Margin="0,0,0,56" />

                    <Label Text="Subconscious is a distributed agentic AI app, that allows you to create AI agents that run everywhere on every device at the same time."
                           FontSize="14" TextColor="{DynamicResource SecondaryTextColor}"
                           LineBreakMode="WordWrap" HorizontalTextAlignment="Center"
                           HorizontalOptions="Fill" Margin="0,0,0,14" />

                    <HorizontalStackLayout Spacing="4" HorizontalOptions="Center" Margin="0,0,0,14">
                        <Label Text="Visit us at:" TextColor="{DynamicResource SecondaryTextColor}"
                               VerticalOptions="Center" />
                        <Label Text="Subconscious.chat" TextDecorations="Underline"
                               TextColor="{DynamicResource PrimaryTextColor}"
                               SemanticProperties.Description="Open Subconscious website"
                               ToolTipProperties.Text="Open subconscious.chat">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OpenWebsiteCommand}" />
                            </Label.GestureRecognizers>
                        </Label>
                    </HorizontalStackLayout>

                    <Label Text="View License" TextDecorations="Underline"
                           TextColor="{DynamicResource PrimaryTextColor}" HorizontalOptions="Center"
                           SemanticProperties.Description="View license" ToolTipProperties.Text="View license"
                           Margin="0,0,0,14">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OpenLicenseCommand}" />
                        </Label.GestureRecognizers>
                    </Label>
                    <Label Text="Report an Issue" TextDecorations="Underline"
                           TextColor="{DynamicResource PrimaryTextColor}" HorizontalOptions="Center"
                           SemanticProperties.Description="Report an issue" ToolTipProperties.Text="Report an issue"
                           Margin="0,0,0,18">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ReportIssueCommand}" />
                        </Label.GestureRecognizers>
                    </Label>

                    <Label Text="{Binding Version, StringFormat='Version: v{0}'}"
                           TextColor="{DynamicResource SecondaryTextColor}"
                           HorizontalOptions="Center" Margin="0,0,0,14" />
                    <Label Text="© 2026 Subconscious" TextColor="{DynamicResource SecondaryTextColor}"
                           HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Grid>
        </Grid>

    </Grid>

</ContentView>
