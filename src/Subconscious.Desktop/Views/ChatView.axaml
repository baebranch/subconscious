<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Subconscious.Desktop.ViewModels"
             xmlns:local="using:Subconscious.Desktop.Views"
             x:Class="Subconscious.Desktop.Views.ChatView"
             x:DataType="vm:ChatViewModel"
             Background="White">

  <UserControl.Styles>
    <Style Selector="Button.iconButton">
      <Setter Property="Width" Value="30" />
      <Setter Property="Height" Value="30" />
      <Setter Property="CornerRadius" Value="15" />
      <Setter Property="Background" Value="{StaticResource AccentBrush}" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.iconButton:disabled">
      <Setter Property="Opacity" Value="0.5" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="52,*,Auto,Auto">

    <!-- Header: current thread title + new-thread button. -->
    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="16,0,16,0">
      <TextBlock Grid.Column="0"
                 Text="{Binding CurrentThread.Title, FallbackValue='Subconscious'}"
                 FontSize="14" FontWeight="Medium"
                 Foreground="{StaticResource PrimaryTextBrush}"
                 VerticalAlignment="Center" />
      <Button Grid.Column="1" Classes="iconButton" Content="+" FontSize="16"
              Command="{Binding NewThreadCommand}"
              ToolTip.Tip="New thread" />
    </Grid>

    <Border Grid.Row="0" VerticalAlignment="Bottom" Height="1" Background="{StaticResource DividerBrush}" />

    <!-- Message list. -->
    <ScrollViewer Grid.Row="1" Background="{StaticResource PanelBackgroundBrush}">
      <ItemsControl ItemsSource="{Binding Messages}" Margin="16,16,16,16">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:MessageViewModel">
            <Border Margin="0,0,0,10"
                    HorizontalAlignment="{Binding IsUser, Converter={x:Static local:BoolToAlignmentConverter.Instance}}"
                    MaxWidth="330"
                    Padding="12,10"
                    CornerRadius="10"
                    Background="{Binding IsUser, Converter={x:Static local:BoolToBubbleBrushConverter.Instance}}">
              <TextBlock Text="{Binding Content}"
                         FontSize="12.5"
                         Foreground="{StaticResource PrimaryTextBrush}"
                         TextWrapping="Wrap" />
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

    <!-- Status line. -->
    <TextBlock Grid.Row="2" Text="{Binding StatusText}" FontSize="11"
               Foreground="{StaticResource SecondaryTextBrush}"
               Margin="16,4,16,4" />

    <!-- Composer. -->
    <Grid Grid.Row="3" Margin="16,4,16,16" ColumnDefinitions="*,Auto">
      <Border Grid.Column="0" CornerRadius="12" BorderBrush="{StaticResource DividerBrush}" BorderThickness="1" Background="{StaticResource PanelBackgroundBrush}">
        <TextBox Text="{Binding ComposerText}"
                  Watermark="Type a message..."
                  BorderThickness="0"
                  Background="Transparent"
                  AcceptsReturn="False"
                  Padding="12,10"
                  FontSize="12.5"
                  Name="ComposerBox" />
      </Border>
      <Button Grid.Column="1" Classes="iconButton" Content="➤" Margin="8,0,0,0"
              Command="{Binding SendCommand}"
              IsVisible="{Binding !IsBusy}" />
      <Button Grid.Column="1" Classes="iconButton" Content="■" Margin="8,0,0,0"
              Command="{Binding StopCommand}"
              IsVisible="{Binding IsBusy}" />
    </Grid>

  </Grid>

</UserControl>
