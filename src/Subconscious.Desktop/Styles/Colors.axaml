<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Palette lifted from screens/gui.pen (the purple/lavender theme used across every
       platform mock) so the chat panel matches the design reference. -->
  <Color x:Key="AccentColor">#7C6FE0</Color>
  <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
  <SolidColorBrush x:Key="UserBubbleBrush" Color="#EEEBFB" />
  <SolidColorBrush x:Key="AssistantBubbleBrush" Color="#F2F2F5" />
  <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#FAFAFB" />
  <SolidColorBrush x:Key="DividerBrush" Color="#E5E3ED" />
  <SolidColorBrush x:Key="PrimaryTextBrush" Color="#1F1B2E" />
  <SolidColorBrush x:Key="SecondaryTextBrush" Color="#8A8698" />
</ResourceDictionary>
