<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Subconscious.Terminal</AssemblyName>
    <RootNamespace>Subconscious.Terminal</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Subconscious.TUI\Subconscious.TUI.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(TerminalIsolatedBuild)' != 'true'">
    <ProjectReference Include="..\Subconscious.Client\Subconscious.Client.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(TerminalIsolatedBuild)' == 'true'">
    <!-- Compile the shared client into this assembly so the isolated task uses current source
         without evaluating or building the Client project, which may be in use by another app. -->
    <Compile Include="..\Subconscious.Client\*.cs" LinkBase="Client" />
  </ItemGroup>

  <ItemGroup>
    <!-- Shared brand mark, copied beside the executable for reliable terminal rendering. -->
    <None Include="..\..\screens\logo.txt" Link="Assets\logo.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
