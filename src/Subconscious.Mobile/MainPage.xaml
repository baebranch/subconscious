<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Subconscious.Mobile"
             xmlns:engine="clr-namespace:Subconscious.Mobile.Engine"
             xmlns:native="clr-namespace:Subconscious.Chat.Native;assembly=Subconscious.Chat.Native"
             x:Class="Subconscious.Mobile.MainPage"
             Title="Subconscious">
    <Grid>
        <Grid x:Name="ChatScreen" RowDefinitions="Auto,*,Auto">
            <Grid Padding="12,8" ColumnDefinitions="*,Auto">
                <VerticalStackLayout Spacing="1">
                    <Label Text="{Binding HeaderTitle}" FontAttributes="Bold" FontSize="18" LineBreakMode="TailTruncation" />
                    <Label Text="{Binding StatusText}" FontSize="12" TextColor="{StaticResource Gray500}" />
                </VerticalStackLayout>
                <Button Grid.Column="1" Text="New" Clicked="OnNewThreadClicked" IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBool}}" />
            </Grid>
            <native:NativeChatTranscriptView Grid.Row="1" ItemsSource="{Binding Messages}"
                                             EmptyText="Choose a workspace or start a conversation."
                                             MaximumBubbleWidth="525" />
            <Border Grid.Row="2" Margin="12" Padding="8" Stroke="{StaticResource Gray300}">
                <Border.StrokeShape><RoundRectangle CornerRadius="10" /></Border.StrokeShape>
                <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto" RowSpacing="4">
                    <Editor Grid.Row="0" Grid.ColumnSpan="2" Text="{Binding ComposerText, Mode=TwoWay}"
                            Placeholder="Ask anything…" AutoSize="TextChanges" MaximumHeightRequest="132" />
                    <Picker Grid.Row="1" ItemsSource="{Binding AvailableModels}" ItemDisplayBinding="{Binding Name}"
                            SelectedItem="{Binding SelectedModel, Mode=TwoWay}" Title="Model" />
                    <Button Grid.Row="1" Grid.Column="1" Text="Send" Clicked="OnSendClicked"
                            IsVisible="{Binding IsBusy, Converter={StaticResource InvertedBool}}" />
                    <Button Grid.Row="1" Grid.Column="1" Text="Stop" Clicked="OnStopClicked" IsVisible="{Binding IsBusy}" />
                </Grid>
            </Border>
        </Grid>

        <Grid x:Name="WorkspacesScreen" IsVisible="False" RowDefinitions="Auto,*" Padding="12">
            <Label Text="Workspaces" FontAttributes="Bold" FontSize="20" />
            <CollectionView Grid.Row="1" ItemsSource="{Binding Workspaces}" SelectionMode="Single" SelectionChanged="OnWorkspaceSelected">
                <CollectionView.EmptyView><Label Text="No workspaces are available from the paired engine." HorizontalOptions="Center" VerticalOptions="Center" /></CollectionView.EmptyView>
                <CollectionView.ItemTemplate><DataTemplate x:DataType="engine:Workspace"><VerticalStackLayout Padding="8"><Label Text="{Binding Name}" FontAttributes="Bold" /><Label Text="{Binding Description}" FontSize="12" TextColor="{StaticResource Gray500}" /></VerticalStackLayout></DataTemplate></CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>

        <Grid x:Name="ThreadsScreen" IsVisible="False" RowDefinitions="Auto,*" Padding="12">
            <Label Text="Threads" FontAttributes="Bold" FontSize="20" />
            <CollectionView Grid.Row="1" ItemsSource="{Binding Threads}" SelectionMode="Single" SelectionChanged="OnThreadSelected">
                <CollectionView.EmptyView><Label Text="No threads in this workspace yet." HorizontalOptions="Center" VerticalOptions="Center" /></CollectionView.EmptyView>
                <CollectionView.ItemTemplate><DataTemplate x:DataType="engine:ThreadInfo"><Label Text="{Binding Title, TargetNullValue='Untitled thread'}" Padding="8" /></DataTemplate></CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>

        <VerticalStackLayout x:Name="FilesScreen" IsVisible="False" Padding="24" Spacing="12">
            <Label Text="Files" FontAttributes="Bold" FontSize="20" />
            <Label Text="The shared WYSIWYG contracts are available to Mobile, but its native editor currently has only a Windows handler. File editing will appear here when Android and iOS handlers are implemented." LineBreakMode="WordWrap" />
        </VerticalStackLayout>
        <VerticalStackLayout x:Name="SettingsScreen" IsVisible="False" Padding="24" Spacing="12">
            <Label Text="Settings" FontAttributes="Bold" FontSize="20" />
            <Label Text="This app connects to the same authenticated engine protocol as Desktop. Android and iOS require a paired-engine discovery/endpoint workflow; local runtime-file discovery only works on Windows and Mac Catalyst." LineBreakMode="WordWrap" />
        </VerticalStackLayout>
        <VerticalStackLayout x:Name="AccountScreen" IsVisible="False" Padding="24" Spacing="12">
            <Label Text="Account" FontAttributes="Bold" FontSize="20" />
            <Label Text="Account management is provided by the Subconscious engine and will be surfaced here with the mobile pairing flow." LineBreakMode="WordWrap" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
