<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
  xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
  xmlns:local="clr-namespace:Subconscious.Mobile"
  x:Class="Subconscious.Mobile.MainPage"
  Title="Chat">

    <Grid RowDefinitions="*,Auto">

        <!-- Message list. Bound to the Messages collection exposed by MainPage itself
             (BindingContext is set to "this" in the code-behind) so no separate
             view model is needed for this dummy slice. -->
        <CollectionView x:Name="MessagesView"
                        Grid.Row="0"
                        ItemsSource="{Binding Messages}"
                        Margin="12,12,12,0"
                        VerticalOptions="Fill">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="local:ChatMessage">
                    <Grid Padding="0,4">
                        <Border Padding="12,8"
                                MaximumWidthRequest="280"
                                StrokeThickness="0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8" />
                            </Border.StrokeShape>
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding IsFromUser}" Value="True">
                                    <Setter Property="BackgroundColor" Value="#512BD4" />
                                    <Setter Property="HorizontalOptions" Value="End" />
                                </DataTrigger>
                                <DataTrigger TargetType="Border" Binding="{Binding IsFromUser}" Value="False">
                                    <Setter Property="BackgroundColor" Value="#E6E6EA" />
                                    <Setter Property="HorizontalOptions" Value="Start" />
                                </DataTrigger>
                            </Border.Triggers>
                            <Label Text="{Binding Text}" FontSize="15">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding IsFromUser}" Value="True">
                                        <Setter Property="TextColor" Value="White" />
                                    </DataTrigger>
                                    <DataTrigger TargetType="Label" Binding="{Binding IsFromUser}" Value="False">
                                        <Setter Property="TextColor" Value="Black" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                        </Border>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Input row: one rounded "pill" holding the multi-line editor and an
             overlaid send icon, so it reads as a single control even though it's
             really an Editor + a tappable icon sitting next to it in a Grid. -->
        <Border Grid.Row="1"
                Margin="12"
                Padding="10,4,4,4"
                StrokeThickness="1"
                Stroke="#D0D0D6"
                BackgroundColor="White">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="8" />
            </Border.StrokeShape>

            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="4">

                <!-- Multi-line input. AutoSize grows the control with the text;
                     MaximumHeightRequest caps growth at roughly 5 lines, after which
                     the native text view scrolls internally on its own. There's no
                     "MaxLines" property on Editor (unlike Android's native TextView),
                     so this cap is an estimated pixel height, not an exact line count —
                     retune it if FontSize changes. -->
                <Editor x:Name="MessageEditor"
                        Grid.Column="0"
                        Placeholder="Type a message..."
                        FontSize="16"
                        AutoSize="TextChanges"
                        MinimumHeightRequest="40"
                        MaximumHeightRequest="132"
                        BackgroundColor="Transparent"
                        VerticalOptions="Center" />

                <!-- Send "button": Button can't host arbitrary content (no built-in
                     vector icon support), so this is a small circular Border with a
                     triangle Path drawn by hand, tapped via a GestureRecognizer
                     instead of a real Button click. -->
                <Border Grid.Column="1"
                        WidthRequest="36"
                        HeightRequest="36"
                        Padding="0"
                        Margin="0,0,0,2"
                        BackgroundColor="#512BD4"
                        VerticalOptions="End">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="18" />
                    </Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnSendClicked" />
                    </Border.GestureRecognizers>
                    <Path Data="M0,0 L12,6 L0,12 Z"
                          Fill="White"
                          WidthRequest="12"
                          HeightRequest="12"
                          HorizontalOptions="Center"
                          VerticalOptions="Center" />
                </Border>

            </Grid>
        </Border>

    </Grid>

</ContentPage>
