<?xml version="1.0" encoding="UTF-8"?>
<Shell x:Class="Subconscious.Mobile.AppShell"
       xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:local="clr-namespace:Subconscious.Mobile"
       xmlns:engine="clr-namespace:Subconscious.Mobile.Engine"
       FlyoutBackgroundColor="{StaticResource Gray900}"
       Title="Subconscious">
    <!-- The phone flyout combines Desktop's narrow sidebar (left) and context panel (right). -->
    <ShellContent Route="Home" ContentTemplate="{DataTemplate local:MainPage}" />
    <Shell.FlyoutContent>
        <Grid ColumnDefinitions="112,*" BackgroundColor="{StaticResource Gray900}">
            <Grid Grid.Column="0" RowDefinitions="Auto,*,Auto" Padding="8,16" BackgroundColor="{StaticResource Gray950}">
                <VerticalStackLayout Spacing="4">
                    <Label Text="NAVIGATE" FontSize="10" TextColor="{StaticResource Gray400}" />
                    <Label Text="Chat" TextColor="White" Padding="8,12"><Label.GestureRecognizers><TapGestureRecognizer Tapped="OnNavigateTapped" CommandParameter="chat" /></Label.GestureRecognizers></Label>
                    <Label Text="Workspaces" TextColor="White" Padding="8,12"><Label.GestureRecognizers><TapGestureRecognizer Tapped="OnNavigateTapped" CommandParameter="workspaces" /></Label.GestureRecognizers></Label>
                    <Label Text="Threads" TextColor="White" Padding="8,12"><Label.GestureRecognizers><TapGestureRecognizer Tapped="OnNavigateTapped" CommandParameter="threads" /></Label.GestureRecognizers></Label>
                    <Label Text="Files" TextColor="White" Padding="8,12"><Label.GestureRecognizers><TapGestureRecognizer Tapped="OnNavigateTapped" CommandParameter="files" /></Label.GestureRecognizers></Label>
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Row="2" Spacing="4">
                    <Label Text="Settings" TextColor="White" Padding="8,12"><Label.GestureRecognizers><TapGestureRecognizer Tapped="OnNavigateTapped" CommandParameter="settings" /></Label.GestureRecognizers></Label>
                    <Label Text="Account" TextColor="White" Padding="8,12"><Label.GestureRecognizers><TapGestureRecognizer Tapped="OnNavigateTapped" CommandParameter="account" /></Label.GestureRecognizers></Label>
                </VerticalStackLayout>
            </Grid>

            <Grid Grid.Column="1" RowDefinitions="Auto,Auto,*,Auto" Padding="16" RowSpacing="10">
                <Label Text="CONTEXT" FontSize="10" TextColor="{StaticResource Gray400}" />
                <Picker Grid.Row="1" Title="Choose workspace" ItemsSource="{Binding Workspaces}"
                        ItemDisplayBinding="{Binding Name}" SelectedItem="{Binding CurrentWorkspace}"
                        SelectedIndexChanged="OnWorkspaceChanged" TextColor="White" TitleColor="{StaticResource Gray300}" />
                <CollectionView Grid.Row="2" ItemsSource="{Binding Threads}" SelectionMode="Single" SelectionChanged="OnThreadSelected">
                    <CollectionView.EmptyView><Label Text="No threads yet" TextColor="{StaticResource Gray400}" /></CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="engine:ThreadInfo">
                            <Label Text="{Binding Title, TargetNullValue='Untitled thread'}" TextColor="White" Padding="0,8" LineBreakMode="TailTruncation" />
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
                <Button Grid.Row="3" Text="New conversation" Clicked="OnNewConversationClicked" />
            </Grid>
        </Grid>
    </Shell.FlyoutContent>
</Shell>
