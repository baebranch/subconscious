<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net10.0-android</TargetFrameworks>
		<TargetFrameworks Condition="!$([MSBuild]::IsOSPlatform('linux'))">$(TargetFrameworks);net10.0-ios;net10.0-maccatalyst</TargetFrameworks>
		<TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net10.0-windows10.0.19041.0</TargetFrameworks>

		<!-- Note for MacCatalyst:
		The default runtime is maccatalyst-x64, except in Release config, in which case the default is maccatalyst-x64;maccatalyst-arm64.
		When specifying both architectures, use the plural <RuntimeIdentifiers> instead of the singular <RuntimeIdentifier>.
		The Mac App Store will NOT accept apps with ONLY maccatalyst-arm64 indicated;
		either BOTH runtimes must be indicated or ONLY macatalyst-x64. -->
		<!-- For example: <RuntimeIdentifiers>maccatalyst-x64;maccatalyst-arm64</RuntimeIdentifiers> -->

		<OutputType>Exe</OutputType>
		<RootNamespace>Subconscious.Mobile</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<!-- Enable XAML source generation for faster build times and improved performance.
		     This generates C# code from XAML at compile time instead of runtime inflation.
		     To disable, remove this line.
		     For individual files, you can override by setting Inflator metadata:
		       <MauiXaml Update="MyPage.xaml" Inflator="Default" /> (reverts to defaults: Runtime for Debug, XamlC for Release)
		       <MauiXaml Update="MyPage.xaml" Inflator="Runtime" /> (force runtime inflation) -->
		<MauiXamlInflator>SourceGen</MauiXamlInflator>

		<!-- Display name -->
		<ApplicationTitle>Subconscious.Mobile</ApplicationTitle>

		<!-- App Identifier -->
		<ApplicationId>com.companyname.subconscious.mobile</ApplicationId>

		<!-- Versions -->
		<ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>

		<!-- To develop, package, and publish an app to the Microsoft Store, see: https://aka.ms/MauiTemplateUnpackaged -->
		<WindowsPackageType>None</WindowsPackageType>

		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">21.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
		<TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)' == 'Debug'">
		<!-- Match EngineHost's deterministic development endpoint for local Windows/MacCatalyst debugging. -->
		<DefineConstants>$(DefineConstants);SUBCONSCIOUS_LOCAL_ENGINE</DefineConstants>
		<!-- Android emulators access the host's loopback through 10.0.2.2; Debug code opts into its restricted HTTP policy. -->
	</PropertyGroup>

	<PropertyGroup>
		<!-- Maui's Android resizetizer derives the launcher resource name from the input filename,
		     not its Link metadata. Copy the selected mark to an intermediate appicon.svg so both
		     configurations generate the manifest's @mipmap/appicon resource. -->
		<MauiLauncherIconSource Condition="'$(Configuration)' == 'Debug'">$(MSBuildProjectDirectory)\Resources\AppIcon\appicon_dev.svg</MauiLauncherIconSource>
		<MauiLauncherIconSource Condition="'$(Configuration)' != 'Debug'">$(MSBuildProjectDirectory)\Resources\AppIcon\appicon.svg</MauiLauncherIconSource>
		<MauiLauncherIconPath>$(MSBuildProjectDirectory)\obj\$(Configuration)\$(TargetFramework)\MauiAppIcon\appicon.svg</MauiLauncherIconPath>
	</PropertyGroup>

	<ItemGroup>
		<!-- appicon.svg is the generated resource's stable Android name, not a duplicate source asset. -->
		<MauiIcon Include="$(MauiLauncherIconPath)" Color="#FFFFFF" />

		<!-- Splash Screen mirrors the corresponding configuration's complete mark. -->
		<MauiSplashScreen Include="Resources\Splash\appicon_dev.svg" Color="#FFFFFF" BaseSize="128,128" Condition="'$(Configuration)' == 'Debug'" />
		<MauiSplashScreen Include="Resources\Splash\appicon.svg" Color="#FFFFFF" BaseSize="128,128" Condition="'$(Configuration)' != 'Debug'" />

		<!-- Images -->
		<MauiImage Include="Resources\Images\*" />
		
		<!-- Custom Fonts -->
		<MauiFont Include="Resources\Fonts\*" />

		<!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
		<!-- Keep Mobile's package set aligned with Desktop where the UI uses shared chat rendering. -->
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
		<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
		<PackageReference Include="AathifMahir.Maui.MauiIcons.Fluent" Version="6.0.0" />
		<PackageReference Include="Markdig" Version="0.40.0" />
	</ItemGroup>

	<ItemGroup>
		<!-- Shared, UI-neutral transcript contracts and the retained native transcript host used by Desktop. -->
		<ProjectReference Include="..\Subconscious.Chat\Subconscious.Chat.csproj" />
		<ProjectReference Include="..\Subconscious.Chat.Native\Subconscious.Chat.Native.csproj" />
		<!-- Referenced for the shared editor contracts. It currently provides a Windows native handler;
		     phone file editing stays deliberately unavailable until Android/iOS handlers are implemented. -->
		<ProjectReference Include="..\Subconscious.WYSIWYG\Subconscious.WYSIWYG.csproj" />
	</ItemGroup>

	<Target Name="PrepareMauiLauncherIcon" BeforeTargets="ProcessMauiAssets">
		<MakeDir Directories="$([System.IO.Path]::GetDirectoryName('$(MauiLauncherIconPath)'))" />
		<Copy SourceFiles="$(MauiLauncherIconSource)" DestinationFiles="$(MauiLauncherIconPath)" />
	</Target>

</Project>
