{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  //
  // Subconscious.Host.Cli multi-targets net10.0-windows;net10.0 (see its csproj) so the
  // real Windows tray icon (System.Windows.Forms.NotifyIcon, in Subconscious.Desktop.Tray)
  // is only present in the net10.0-windows build - the plain net10.0 build always gets the
  // no-op tray service, even when run on Windows. These configs target net10.0-windows so
  // debugging the tray icon actually exercises it.
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Mobile (Dev)",
      "type": "coreclr",
      "request": "launch",
      "program": "dotnet",
      "args": [
        "watch",
        "run",
        "--project",
        "Subconscious.Mobile/Subconscious.Mobile.csproj",
        "--framework",
        "net10.0-android"
      ],
      "cwd": "${workspaceFolder}/Src",
      "stopAtEntry": false,
      // "preLaunchTask": "build-mobile"
    },
    {
      "name": "Engine (Dev)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build-engine-host-windows",
      "program": "${workspaceFolder}/src/Subconscious.Host.Cli/bin/Debug/net10.0-windows/subconscious.dll",
      "args": ["engine", "--dev"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "stopAtEntry": false
    },
    {
      "name": "Engine (Dev, headless)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build-engine-host-windows",
      "program": "${workspaceFolder}/src/Subconscious.Host.Cli/bin/Debug/net10.0-windows/subconscious.dll",
      "args": ["engine", "--dev", "--headless", "--lan"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "stopAtEntry": false
    },
    {
      "name": "Engine (Dev, no API)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build-engine-host-windows",
      "program": "${workspaceFolder}/src/Subconscious.Host.Cli/bin/Debug/net10.0-windows/subconscious.dll",
      "args": ["engine", "--dev", "--no-api"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "stopAtEntry": false
    },
    {
      "name": "Desktop (Dev)",
      "type": "coreclr",
      "request": "launch",
      "program": "dotnet",
      "args": [
        "watch",
        "run",
        "--project",
        "src/Subconscious.Desktop/Subconscious.Desktop.csproj",
        "--framework",
        "net10.0-windows10.0.19041.0",
        "--",
        "--dev"
      ],
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "build-desktop",
      "console": "integratedTerminal",
      "stopAtEntry": false
    },
    {
      "name": "Terminal (Dev, native scrollback)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build-terminal",
      "program": "${workspaceFolder}/artifacts/terminal-debug/Debug/net10.0/Subconscious.Terminal.exe",
      // External Run Command: .\artifacts\terminal-debug\Debug\net10.0\Subconscious.Terminal.exe
      // Force native scrollback; Terminal.Gui remains available only through an explicit --gui launch.
      "args": ["--dev", "--ansi"],
      "cwd": "${workspaceFolder}",
      "env": {
        "PATH": "${workspaceFolder}\\src\\Subconscious.Host.Cli\\bin\\Debug\\net10.0-windows;${env:PATH}"
      },
      "console": "externalTerminal",
      "internalConsoleOptions": "neverOpen",
      "stopAtEntry": false
    },
    {
      "name": "WYSIWYG Debug (Standalone)",
      "type": "coreclr",
      "request": "launch",
      "program": "dotnet",
      "args": [
        "run",
        "--project",
        "src/Subconscious.WYSIWYG.Debug/Subconscious.WYSIWYG.Debug.csproj",
        "--framework",
        "net10.0-windows10.0.19041.0"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "stopAtEntry": false
    },
    {
      "name": "Chat Web (Placeholder Messages)",
      "type": "coreclr",
      "request": "launch",
      "program": "dotnet",
      "args": [
        "run",
        "--no-build",
        "--project",
        "src/Subconscious.Chat.Debug/Subconscious.Chat.Debug.csproj",
        "--framework",
        "net10.0-windows10.0.19041.0",
        "--",
        "--renderer",
        "web"
      ],
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "build-chat-debug",
      "console": "integratedTerminal",
      "stopAtEntry": false
    },
    {
      "name": "Chat Native (Placeholder Messages)",
      "type": "coreclr",
      "request": "launch",
      "program": "dotnet",
      "args": [
        "run",
        "--no-build",
        "--project",
        "src/Subconscious.Chat.Debug/Subconscious.Chat.Debug.csproj",
        "--framework",
        "net10.0-windows10.0.19041.0",
        "--",
        "--renderer",
        "native"
      ],
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "build-chat-debug",
      "console": "integratedTerminal",
      "stopAtEntry": false
    },
    {
      "name": ".NET Attach",
      "type": "coreclr",
      "request": "attach"
    }
  ],
  "compounds": [
    {
      "name": "Engine + Desktop (Dev)",
      "configurations": [
        "Engine (Dev, headless)",
        "Desktop (Dev)"
      ],
      "stopAll": true
    }
  ]
}
