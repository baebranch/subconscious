{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Subconscious Engine (Dev)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build-engine-host",
      "program": "${workspaceFolder}/src/Subconscious.Host.Cli/bin/Debug/net10.0/subconscious.dll",
      "args": ["engine", "--dev"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "stopAtEntry": false
    },
    {
      "name": "Subconscious Engine (Dev, no API)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build-engine-host",
      "program": "${workspaceFolder}/src/Subconscious.Host.Cli/bin/Debug/net10.0/subconscious.dll",
      "args": ["engine", "--dev", "--no-api"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "stopAtEntry": false
    },
    {
      "name": ".NET Attach",
      "type": "coreclr",
      "request": "attach"
    }
  ]
}
