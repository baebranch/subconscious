<Project>

  <PropertyGroup>
    <!--
      Deliberately NOT setting TargetFramework/TargetFrameworks here. Directory.Build.props
      is imported before each project's own body, so a shared TargetFramework set here would
      win over a project's own <TargetFrameworks> (plural, multi-targeting) - the SDK decides
      single- vs. multi-targeting before the project body is ever evaluated, and a non-empty
      TargetFramework short-circuits that decision to single-targeting. Every project sets its
      own TargetFramework or TargetFrameworks explicitly instead (see e.g.
      Subconscious.Desktop.Tray.csproj, which multi-targets net10.0-windows;net10.0).
    -->
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <WarningsAsErrors>nullable</WarningsAsErrors>
    <!--
      ICU must stay enabled. InvariantGlobalization=true (the value the project templates
      default to) disables ICU, and with it TimeZoneInfo's IANA/Windows identifier conversion:
      on Windows the OS timezone database is keyed by Windows ids, so "Europe/London" simply
      fails to resolve. The engine's time tools take IANA names as their documented contract
      (ported from Python zoneinfo), and models emit IANA names, so invariant mode is not an
      option here. Verified by test: TimeToolModuleTests.GetCurrentTime_IanaZone_*.
    -->
    <InvariantGlobalization>false</InvariantGlobalization>

    <Company>Subconscious</Company>
    <Product>Subconscious</Product>
    <Copyright>Copyright (c) 2026 - Brian Branch</Copyright>
    <Version>0.1.0</Version>
  </PropertyGroup>

</Project>
